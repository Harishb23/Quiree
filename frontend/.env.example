# Copy to .env.local and fill in. Never put secrets here - everything VITE_* is public.
VITE_APP_NAME=ProLink ID
# Base URL of the API. Keep "/api" when the API is served from the same origin (recommended for PWA).
VITE_API_BASE_URL=/api
# Google Identity Services OAuth client id (public value)
VITE_GOOGLE_CLIENT_ID=
